{
  "name": "dsh-skill-studio",
  "version": "1.4.0",
  "description": "Create, install, and manage reusable agent skills from a DeepSeek Harness session, with a settings UI.",
  "type": "module",
  "license": "MIT",
  "author": "ZTYZZ",
  "homepage": "https://github.com/ZTYZZ/dsh-skill-studio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZTYZZ/dsh-skill-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ZTYZZ/dsh-skill-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "skills",
    "skill-creator",
    "agent"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check client.js && node --check lib/frontmatter.js && node --check lib/skills.js && node --check lib/install.js && node --check lib/external.js && node --check lib/meta-skill.js"
  },
  "engines": {
    "node": ">=20"
  }
}
